generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  walletAddress String?
  pixIdentifier String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  pixPayments   PixPayment[]
}

model Account {
  id                      Int               @id @default(autoincrement())
  userId                  Int
  totalBalance            Float             @default(0)
  availableBalance        Float             @default(0)
  pooledBalance           Float             @default(0)
  yieldBalance            Float             @default(0)
  autoRechargeEnabled     Boolean           @default(true)
  autoRechargeThreshold   Float             @default(5)
  suggestedRechargeAmount Float             @default(20)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  user                    User              @relation(fields: [userId], references: [id])
  pixPayments             PixPayment[]
  ledgerEntries           LedgerEntry[]
  usageEvents             UsageEvent[]
  rechargeRequests        RechargeRequest[]
  agents                  Agent[]
}

model PixPayment {
  id            Int       @id @default(autoincrement())
  userId        Int
  accountId     Int
  externalRef   String    @unique
  amount        Float
  status        String    @default("pending")
  qrCodePayload String
  createdAt     DateTime  @default(now())
  settledAt     DateTime?
  user          User      @relation(fields: [userId], references: [id])
  account       Account   @relation(fields: [accountId], references: [id])
}

model LedgerEntry {
  id           Int       @id @default(autoincrement())
  accountId    Int
  type         String
  direction    String
  amount       Float
  category     String
  referenceId  String?
  metadataJson String?
  createdAt    DateTime  @default(now())
  account      Account   @relation(fields: [accountId], references: [id])
}

model PoolState {
  id                 Int      @id @default(autoincrement())
  totalLiquidity     Float
  availableLiquidity Float
  allocatedLiquidity Float
  safetyReserve      Float
  policyMode         String
  updatedAt          DateTime @updatedAt
}

model UsageEvent {
  id            Int       @id @default(autoincrement())
  accountId     Int
  sourceType    String
  sourceName    String
  units         Float
  unitCost      Float
  amountCharged Float
  metadataJson  String?
  createdAt     DateTime  @default(now())
  account       Account   @relation(fields: [accountId], references: [id])
}

model RechargeRequest {
  id            Int       @id @default(autoincrement())
  accountId     Int
  amount        Float
  status        String
  triggerReason String
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  account       Account   @relation(fields: [accountId], references: [id])
}

model Agent {
  id              Int            @id @default(autoincrement())
  accountId       Int
  name            String
  status          String
  maxBudget       Float
  currentSpend    Float
  priority        String
  permissionsJson String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  account         Account        @relation(fields: [accountId], references: [id])
  agentTasks      AgentTask[]
  outgoing        AgentPayment[] @relation("OutgoingAgentPayments")
  incoming        AgentPayment[] @relation("IncomingAgentPayments")
}

model AgentTask {
  id           Int      @id @default(autoincrement())
  agentId      Int
  taskType     String
  cost         Float
  status       String
  metadataJson String?
  createdAt    DateTime @default(now())
  agent        Agent    @relation(fields: [agentId], references: [id])
}

model AgentPayment {
  id          Int      @id @default(autoincrement())
  fromAgentId Int
  toAgentId   Int
  amount      Float
  reason      String
  status      String
  createdAt   DateTime @default(now())
  fromAgent   Agent    @relation("OutgoingAgentPayments", fields: [fromAgentId], references: [id])
  toAgent     Agent    @relation("IncomingAgentPayments", fields: [toAgentId], references: [id])
}

model YieldSnapshot {
  id           Int      @id @default(autoincrement())
  poolStateId   Int
  allocatedBase Float
  accruedYield  Float
  apyEstimate   Float
  createdAt     DateTime @default(now())
}
